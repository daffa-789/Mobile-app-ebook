{
  "expo": {
    "name": "Mobile-app-ebook",
    "slug": "mobile-app-ebook",
    "owner": "jualendfield1610s-team",
    "version": "0.1.8",
    "scheme": "mobileappebook",
    "orientation": "portrait",
    "icon": "./mobile-app/assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "id.wahidiyah.book",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#067554",
        "foregroundImage": "./mobile-app/assets/android-icon-foreground.png",
        "backgroundImage": "./mobile-app/assets/android-icon-background.png"
      }
    },
    "web": {
      "favicon": "./mobile-app/assets/favicon.png"
    },
    "updates": {
      "url": "https://u.expo.dev/ef5df259-9b15-4288-80de-5fdff2510d5a"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "minSdkVersion": 24,
            "useHermesV1": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F3"
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.8108075809-kpcgb73h2d1t7klg785svrlqc9to3n9t"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ef5df259-9b15-4288-80de-5fdff2510d5a"
      }
    }
  }
}

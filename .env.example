# ==========================================================
# WAHIDIYAH BOOK — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# Salin berkas ini ke .env untuk pengembangan lokal.
# JANGAN PERNAH commit berkas .env yang berisi kredensial asli!
# ==========================================================

# 1. SERVER PORTS & HOSTING
PORT=5000
VITE_PORT=3000
VITE_LANDING_PORT=3000
VITE_ADMIN_PORT=3001
NODE_ENV=development

# 2. CORS & DOMAIN ORIGINS
# Daftar domain yang diizinkan memanggil backend Express (pisahkan dengan koma)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5000,http://127.0.0.1:5000
# Origin frontend kanonikal untuk callback OAuth
FRONTEND_ORIGIN=http://localhost:3000

# 3. BACKEND AUTHENTICATION (JWT)
# String acak minimal 32 karakter untuk menandatangani token sesi
JWT_SECRET=your-random-32-character-secret-key-here
JWT_EXPIRES_IN=12h

# 4. SUPABASE CLOUD (DATABASE & STORAGE)
# Kunci Anonim Publik (aman diekspos ke client bundle Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Kunci Backend (HANYA UNTUK SERVER - JANGAN EKSPOS KE CLIENT)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_REGION=ap-southeast-1 (Singapore)

# 5. GOOGLE OAUTH 2.0 (SIGN-IN & GMAIL API)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 6. GMAIL API (OTP EMAIL NOTIFICATION)
GMAIL_SENDER=your-email@gmail.com
GMAIL_REFRESH_TOKEN=your-gmail-oauth-refresh-token
GMAIL_SENDER_NAME=Buku Wahidiyah

# 7. MIDTRANS CORE API (PAYMENT GATEWAY QRIS)
MIDTRANS_SERVER_KEY=Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay
MIDTRANS_QRIS_EXPIRY_MINUTES=15

# 8. WHATSAPP GATEWAY (FONNTE)
WHATSAPP_PROVIDER=fonnte
FONNTE_TOKEN=your-fonnte-token-here

# 9. WEB PUSH NOTIFICATIONS (VAPID)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:your-email@example.com
PUSH_REMINDER_HOUR=08:00

# 10. CRON & MAINTENANCE
CRON_SECRET=your-secure-cron-secret-at-least-16-chars

# 11. CLIENT DOWNLOAD & API OVERRIDES
VITE_APK_DOWNLOAD_URL=https://expo.dev/artifacts/eas/qdKRlQGtuS4qap2eylCUfl46_HuxOLHgo3p9tUPCQHs.apk
VITE_API_TIMEOUT_MS=20000
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_API_TIMEOUT_MS=20000

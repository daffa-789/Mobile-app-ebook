# Salin ke .env.e2e di root repo. Isi hanya dari project Supabase khusus tes.
# Jangan gunakan URL, project ref, atau secret/service-role key production.
E2E_SUPABASE_URL=https://replace-with-test-project-ref.supabase.co
E2E_SUPABASE_PROJECT_REF=replace-with-test-project-ref
E2E_SUPABASE_SECRET_KEY=your-supabase-secret-key
E2E_SUPABASE_ANON_KEY=

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "paths": {
      "@/*": ["./landing-page/src/*", "./admin-dashboard-web/src/*"],
      "@features/*": ["./admin-dashboard-web/src/features/*"],
      "@ui/*": ["./admin-dashboard-web/src/components/ui/*"],
      "@lib/*": ["./admin-dashboard-web/src/lib/*"],
      "@data/*": ["./admin-dashboard-web/src/data/*"],
      "@context/*": ["./admin-dashboard-web/src/context/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "landing-page/**/*",
    "admin-dashboard-web/**/*",
    "mobile-app/**/*",
    "shared/**/*",
    "server/**/*",
    "scripts/**/*",
    "vite.config.landing.js",
    "vite.config.admin.js",
    "tailwind.config.js"
  ],
  "exclude": ["node_modules", "dist", "dist-*", ".agents"]
}

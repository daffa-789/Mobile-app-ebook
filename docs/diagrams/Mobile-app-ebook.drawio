        <mxCell id="a_scope_note" data-source="server/routes/transactions_routes.js:24-51; admin-dashboard-web/src/App.jsx:20-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Operasi independen&lt;/b&gt;&lt;br&gt;Admin memilih kelola konten, pengguna, laporan, atau monitoring; bukan satu alur wajib.&lt;br&gt;&lt;br&gt;Endpoint verifikasi manual masih ada, tetapi bukan langkah QRIS dan tidak ada tombol approve/reject di dashboard web saat ini." vertex="1">
          <mxGeometry height="225" width="210" x="955" y="310" as="geometry" />
        </mxCell>
        <mxCell id="a_qris_note" data-source="server/services/payment/settlement_service.js:35-88; server/lib/membership.js:79-129" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;QRIS: jalur otomatis&lt;/b&gt;&lt;br&gt;Polling / webhook tervalidasi memanggil settlement_service.&lt;br&gt;CAS hanya jika pending; aktivasi users lalu subscriptions.&lt;br&gt;Gagal aktivasi: coba pulihkan pending (bukan transaksi DB lintas tabel).&lt;br&gt;Reject admin tidak mengaktifkan Pro." vertex="1">
          <mxGeometry height="225" width="210" x="955" y="1095" as="geometry" />
        </mxCell>
        <mxCell id="a_otp_note" data-source="server/lib/otp.js:13-15,96-123; server/services/auth/otp_resend_service.js:38-60" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;OTP&lt;/b&gt;&lt;br&gt;TTL 10 menit; setelah 5 kegagalan, pemeriksaan berikut menghapus kode.&lt;br&gt;Resend minimal 60 detik untuk permintaan yang masih ada.&lt;br&gt;Tidak ada lock akun 10 menit." vertex="1">
          <mxGeometry height="170" width="210" x="955" y="575" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>

{
  "name": "aplikasi-buku-wahidiyah",
  "private": true,
  "version": "0.1.0-alpha",
  "type": "module",
  "main": "mobile-app/index.js",
  "description": "Perpustakaan digital Wahidiyah — katalog buku, membership Pro, dan pembayaran QRIS via Midtrans Core API.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/start.js",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "health": "node scripts/health-check.js",
    "check": "npm run format:check && npm run health",
    "check:full": "npm run check && npm run build",
    "test": "npm run check",
    "clean:ports": "node scripts/clean-ports.js",
    "check:ports": "node scripts/check-ports.js",
    "dev:frontend": "vite",
    "dev:landing": "vite --config vite.config.landing.js",
    "build:landing": "vite build --config vite.config.landing.js",
    "dev:admin": "vite --config vite.config.admin.js",
    "build:admin": "vite build --config vite.config.admin.js",
    "build:all": "npm run build && npm run build:landing && npm run build:admin",
    "dev:server": "node --watch server/server.js",
    "server": "node server/server.js",
    "server:dev": "node --watch server/server.js",
    "gmail:token": "node scripts/get-gmail-token.js",
    "vapid:keys": "node scripts/generate-vapid-keys.js",
    "audit:security": "npm audit --audit-level=high",
    "mobile:start": "expo start",
    "mobile:android": "expo start --android",
    "mobile:ios": "expo start --ios",
    "mobile:web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "^58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.7",
    "expo": "~58.0.23",
    "expo-file-system": "~58.0.13",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.21",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.3.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "mammoth": "^1.13.0",
    "midtrans-client": "^1.4.3",
    "multer": "^2.4.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "^4.10.38",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.2",
    "prettier": "^3.9.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.1.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

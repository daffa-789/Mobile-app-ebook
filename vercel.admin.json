{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "mobile-app-ebook-admin",
  "buildCommand": "npm run build:admin",
  "outputDirectory": "dist/admin",
  "framework": "vite",
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "regions": ["sin1"],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://mobile-app-ebook.vercel.app/unduh/wahidiyah-v0.1.5-hermes-32bit.apk",
      "permanent": false
    },
    {
      "source": "/download/apk",
      "destination": "https://mobile-app-ebook.vercel.app/unduh/wahidiyah-v0.1.5-hermes-32bit.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/unduh/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"wahidiyah-v0.1.5-hermes-32bit.apk\""
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

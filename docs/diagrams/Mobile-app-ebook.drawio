        <mxCell id="scope_current" data-source="mobile-app/App.js:28-43,198-208,302-309; mobile-app/src/screens/ReaderScreen.js:23-85; mobile-app/src/screens/SubscriptionHistoryScreen.js:11-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;BATAS IMPLEMENTASI - bukan paritas antar-klien&lt;/b&gt;&lt;br&gt;Mobile: AuthProvider + BookProvider, tab manual, cache teks offline; PDF hanya preview.&lt;br&gt;PWA: PDF.js, posisi baca localStorage, kwitansi PDF. Web push memerlukan izin browser.&lt;br&gt;&lt;b&gt;Konsep riset / belum diterapkan di mobile:&lt;/b&gt; PDF penuh, posisi baca permanen, unduh kwitansi PDF, native push.&lt;br&gt;CAS sudah ada di server; bukan transaksi atomik lintas tabel, bukan dashboard audit idempotensi." vertex="1">

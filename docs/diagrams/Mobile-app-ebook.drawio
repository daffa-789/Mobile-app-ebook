          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="m27" edge="1" parent="1" source="act9" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#999999;fontColor=#999999;exitX=0;exitY=1.0;entryX=0.5;entryY=0.9444;" target="u" value="25. Web push ke browser&#xa;yang berlangganan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_charge" edge="1" parent="1" source="act5" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.24;entryX=0.5;entryY=0.5320987654321;" target="midtrans" value="POST /v2/charge (QRIS)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_charge_reply" edge="1" parent="1" source="midtrans" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5469135802469;entryX=1;entryY=0.72;strokeColor=#64748b;" target="act5" value="qr_string / QR image URL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_poll_request" edge="1" parent="1" source="u" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.5740740740741;entryX=0.5;entryY=0.5740740740741;" target="sys" value="Poll: GET qris/:id/status">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="seq_scope" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Cakupan sequence&lt;/b&gt;&lt;br&gt;Kolom Sistem merangkum klien + Express API. Skenario independen, bukan seluruhnya wajib berurutan.&lt;br&gt;Mobile masuk sebelum katalog; PWA dapat melihat katalog publik tetapi reader memerlukan login.&lt;br&gt;Registrasi sukses langsung memberi JWT; login sandi / Google adalah alternatif untuk akun yang ada." vertex="1">
          <mxGeometry height="160" width="430" x="900" y="40" as="geometry" />
        </mxCell>
        <mxCell id="seq_otp" data-source="server/services/auth/registration_service.js:38-42,148-199; server/lib/otp.js:96-123" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Registrasi 2 fase, satu kanal&lt;/b&gt;&lt;br&gt;POST /api/auth/register: simpan hash OTP + payload.&lt;br&gt;Gmail API mengirim OTP email (bukan dual-channel).&lt;br&gt;POST /api/auth/verify-registration: buat users + sesi.&lt;br&gt;OTP: TTL 10 menit, batas 5 gagal; bukan lock akun.&lt;br&gt;WhatsApp tersedia pada pemulihan sandi / endpoint terkait, bukan pengiriman ganda registrasi." vertex="1">
          <mxGeometry height="165" width="430" x="900" y="330" as="geometry" />
        </mxCell>
        <mxCell id="seq_google" data-source="server/controllers/auth_controller.js:214-377; server/lib/oneTimeCode.js:25-68; mobile-app/App.js:48-74" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Alternatif Google - alur native yang diterapkan&lt;/b&gt;&lt;br&gt;1. Mobile: POST /api/auth/google/mobile-start.&lt;br&gt;2. API simpan state sekali-pakai (5 menit), kembalikan URL.&lt;br&gt;3. Browser Google: HTTPS /api/auth/google/callback.&lt;br&gt;4. API validasi state, tukar kode Google, cari/buat user.&lt;br&gt;5. Redirect mobileappebook://auth/success?code=...&lt;br&gt;6. Mobile Linking: POST /api/auth/exchange, JWT + profil.&lt;br&gt;Kode sesi TTL 60 detik; hash di email_verifications; DELETE RETURNING sekali-pakai. JWT tidak ada di URL.&lt;br&gt;PWA direct: /auth/success?code=... (jalur Supabase juga tersedia)." vertex="1">
          <mxGeometry height="250" width="430" x="900" y="545" as="geometry" />
        </mxCell>
        <mxCell id="seq_qris" data-source="server/services/payment/order_service.js:65-195; server/services/payment/status_service.js:37-118; server/services/payment/notification_service.js:23-59; server/services/payment/settlement_service.js:35-88" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;QRIS: alternatif pemicu, bukan dua pembayaran&lt;/b&gt;&lt;br&gt;Harga server: Rp25.000 + Rp3.000; Pro aktif ditolak; order pending hidup dipakai ulang.&lt;br&gt;&lt;b&gt;15-16:&lt;/b&gt; polling status Midtrans. Mobile tiap 5 detik; berhenti saat timer habis / layar dilepas.&lt;br&gt;&lt;b&gt;17:&lt;/b&gt; ATAU POST /api/payments/midtrans/notification; signature SHA-512, order &amp;amp; jumlah harus cocok.&lt;br&gt;&lt;b&gt;18-20:&lt;/b&gt; settlement bersama; CAS pending ke success, lalu aktivasi. Klaim kalah: tidak aktifkan ulang.&lt;br&gt;Gagal aktivasi: upaya restore pending; bukan transaksi atomik lintas tabel.&lt;br&gt;Gagal / kedaluwarsa: rejected. Error polling: pending. Reconcile mengecek pending milik user (bukan cron pembayaran)." vertex="1">
          <mxGeometry height="285" width="430" x="900" y="855" as="geometry" />
        </mxCell>
        <mxCell id="seq_manual" data-source="server/routes/transactions_routes.js:24-51; admin-dashboard-web/src/features/admin/LogsTab.jsx:32-46; mobile-app/src/screens/SubscriptionHistoryScreen.js:11-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;Admin &amp;amp; batas implementasi&lt;/b&gt;&lt;br&gt;PUT /api/transactions/:id/verify (approve/reject) masih ada dengan auth admin + CAS; bukan langkah wajib QRIS. Dashboard memuat log / transaksi, tanpa tombol verifikasi.&lt;br&gt;22-25 adalah operasi admin terpisah. Pengingat via /api/events/:id/send-reminder; browser harus opt-in.&lt;br&gt;&lt;b&gt;Mobile belum:&lt;/b&gt; PDF penuh, resume permanen, kwitansi PDF (tombol hanya alert), native push." vertex="1">
          <mxGeometry height="205" width="430" x="900" y="1320" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

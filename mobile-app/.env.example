# ==========================================================
# MOBILE APP (EXPO REACT NATIVE) — ENVIRONMENT VARIABLES
# Catatan: Variabel berawalan EXPO_PUBLIC_ di-bundle ke dalam APK/IPA!
# ==========================================================

# Backend API Base URL
# - Emulator Android: http://10.0.2.2:5000/api
# - iOS Simulator / Web: http://localhost:5000/api
# - Perangkat Fisik (LAN): http://192.168.x.x:5000/api
# - Produksi: https://your-domain.com/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Google OAuth Client ID & Redirect
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://mobile-app-expo-sooty.vercel.app/api/auth/google/callback
# Redirect khusus saat menjalankan mobile-app versi web di mesin pengembangan
EXPO_PUBLIC_GOOGLE_LOCAL_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Dukungan Pengguna
EXPO_PUBLIC_SUPPORT_EMAIL=info@wahidiyah.org
